// prisma/schema.prisma
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Admin user
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  tags        String[]
  coverImage  String?  @map("cover_image")
  liveUrl     String?  @map("live_url")
  repoUrl     String?  @map("repo_url")
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("projects")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String
  content     String    // <-- add this (stores markdown/HTML from your editor)
  coverImage  String?   @map("cover_image")
  tags        String[]
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@map("posts")
}

// ─────────────────────────────────────────────
// Testimonials
// ─────────────────────────────────────────────
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  avatar    String?
  content   String
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("testimonials")
}

// ─────────────────────────────────────────────
// Contact messages
// ─────────────────────────────────────────────
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt      @map("updated_at")

  @@map("contact_messages")
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// ─────────────────────────────────────────────
// Profile — singleton row (your personal info)
// ─────────────────────────────────────────────
model Profile {
  id               String   @id @default(cuid())

  // Hero
  name             String
  headline         String                        // e.g. "Full-Stack Engineer"
  tagline          String                        // short punchy subtitle
  bio              String                        // rich markdown bio for About section

  // Media
  profilePhoto     String?  @map("profile_photo") // Cloudinary public_id
  coverPhoto       String?  @map("cover_photo")   // Cloudinary public_id

  // Resume
  resumeUrl        String?  @map("resume_url")    // Cloudinary public_id or external URL
  resumeLabel      String?  @map("resume_label")  // e.g. "Download CV"

  // Availability
  availableForWork Boolean  @default(true)        @map("available_for_work")
  availabilityNote String?  @map("availability_note") // e.g. "Open to remote roles"

  // Address / location
  city             String?
  state            String?
  country          String?
  addressLine      String?  @map("address_line")  // optional street address
  timezone         String?                        // e.g. "Africa/Lagos"

  // Relations
  skills           Skill[]
  experiences      Experience[]
  educations       Education[]
  socialLinks      SocialLink[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  @@map("profile")
}

// ─────────────────────────────────────────────
// Skills
// ─────────────────────────────────────────────
model Skill {
  id          String      @id @default(cuid())
  profileId   String      @map("profile_id")
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String
  category    String                    // e.g. "Frontend", "Backend", "DevOps", "Design"
  proficiency SkillLevel  @default(INTERMEDIATE)
  icon        String?                   // icon name or Cloudinary public_id
  order       Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("skills")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ─────────────────────────────────────────────
// Work Experience
// ─────────────────────────────────────────────
model Experience {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company     String
  role        String
  description String?                   // markdown supported
  location    String?                   // e.g. "Remote" or "Lagos, Nigeria"
  companyUrl  String?  @map("company_url")
  companyLogo String?  @map("company_logo") // Cloudinary public_id
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")   // null = current job
  current     Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("experiences")
}

// ─────────────────────────────────────────────
// Education
// ─────────────────────────────────────────────
model Education {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution String
  degree      String                    // e.g. "B.Sc Computer Science"
  field       String?                   // e.g. "Computer Science"
  description String?
  logo        String?                   // Cloudinary public_id
  startYear   Int      @map("start_year")
  endYear     Int?     @map("end_year")  // null = ongoing
  current     Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("education")
}

// ─────────────────────────────────────────────
// Social Links
// ─────────────────────────────────────────────
model SocialLink {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  platform  String                      // e.g. "GitHub", "LinkedIn", "Twitter"
  url       String
  icon      String?                     // icon name e.g. "github", "linkedin"
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("social_links")
}
