// prisma/schema.prisma
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon connection string
}

// ─────────────────────────────────────────────
// Admin user (single owner, managed via seed)
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String                       // short description (used in cards)
  description String                       // full rich text / markdown
  tags        String[]                     // e.g. ["Next.js", "Postgres"]
  coverImage  String?  @map("cover_image") // Cloudinary public_id
  liveUrl     String?  @map("live_url")
  repoUrl     String?  @map("repo_url")
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)         // manual sort order
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt         @map("updated_at")

  @@map("projects")
}

// ─────────────────────────────────────────────
// Blog post metadata (content lives in MDX files)
// ─────────────────────────────────────────────
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique             // must match MDX filename exactly
  summary     String
  coverImage  String?   @map("cover_image") // Cloudinary public_id
  tags        String[]
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt         @map("updated_at")

  @@map("posts")
}

// ─────────────────────────────────────────────
// Testimonials (visitors can submit; admin approves)
// ─────────────────────────────────────────────
model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String?                        // e.g. "Senior Engineer at Stripe"
  company    String?
  avatar     String?                        // Cloudinary public_id (optional upload)
  content    String
  rating     Int      @default(5)           // 1-5
  approved   Boolean  @default(false)       // admin must approve before display
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt           @map("updated_at")

  @@map("testimonials")
}

// ─────────────────────────────────────────────
// Contact messages
// ─────────────────────────────────────────────
model ContactMessage {
  id        String          @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus   @default(UNREAD)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt      @map("updated_at")

  @@map("contact_messages")
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}
